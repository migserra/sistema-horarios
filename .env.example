# Copie este arquivo para .env e ajuste os valores antes de executar o projeto.
# O arquivo .env nao deve ser versionado no GitHub.
#
# ATENCAO: o Spring Boot nao le arquivos .env automaticamente. Exporte estas
# variaveis no terminal, configure-as na IDE ou em um orquestrador (Docker, CI).

# ------------------------------------------------------------
# Conexao com o MySQL
# ------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/horarios_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo&createDatabaseIfNotExist=true
DB_USERNAME=horarios
DB_PASSWORD=horarios123

# ------------------------------------------------------------
# Usuario administrador criado automaticamente na inicializacao.
# A senha e armazenada no banco com criptografia BCrypt.
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------
# Dados de demonstracao (professores, disciplinas, turmas e horarios)
# Criados somente quando as tabelas estao vazias.
# ------------------------------------------------------------
SEED_DEMO=true

# Porta HTTP da aplicacao
SERVER_PORT=8080
